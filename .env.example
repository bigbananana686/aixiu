# Windows 本地演示可运行 backend/deploy/New-DemoEnv.ps1 自动生成 .env。
APP_HTTP_PORT=18080
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
JWT_SECRET=
# 为本地演示账号生成 BCrypt cost=10 的哈希，使用单引号保留美元符号。
SEED_PASSWORD_HASH=
AIXIU_DEMO_PASSWORD=

AUTOCARE_BOOKING_AI_ENABLED=false
AUTOCARE_EMBEDDING_ENABLED=false
AUTOCARE_QUOTE_AI_ENABLED=false
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
