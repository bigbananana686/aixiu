<?xml version="1.0" encoding="UTF-8"?>
<!--
  auto-care 父 POM（聚合 + 依赖管理），打包类型 pom，本身不出产物。

  版本锁定依据（2026-10-21 现查官方来源，逐条见 切片记录/G0-02/回报-r1.md）：
  - Spring Boot 4.1.1：Maven Central 实存；官方 system-requirements 写明「requires at least Java 17
    and is compatible with versions up to and including Java 26」→ 本机 JDK 21.0.5 在范围内。
  - Spring AI 2.0.1：官方文档原文「Spring AI 2.0.x supports Spring Boot 4.0.x and 4.1.x」——
    Spring AI 2.0 与 Boot 3 系列不兼容，这是本仓库把 Boot 定在 4.x 的原因（设计 §5.2 的
    「Boot 3 系列」需总控追认改为 4 系列）。
  - mybatis-spring-boot-starter 4.1.0：官方 README 兼容表「(master) 4.1.x → Spring Boot 4.1」。
  - mysql-connector-j 9.7.0：Boot 4.1.1 的 spring-boot-dependencies 已把 mysql.version 管到 9.7.0，
    这里仍然显式写出版本，是为了让「锁了什么」在仓库里看得见，而不是藏在 Boot BOM 里。
  - 测试依赖：交给 Boot BOM 管（junit-jupiter 6.0.3 / mockito 5.23.0），不单独钉版本。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.autocare</groupId>
    <artifactId>auto-care</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>auto-care</name>
    <description>上门汽车保养预约与增项协作平台（单体，多模块）</description>

    <modules>
        <!-- 顺序即依赖顺序：common 谁都不依赖 → ai 依赖 common → server 依赖 ai -->
        <module>auto-care-common</module>
        <module>auto-care-ai</module>
        <module>auto-care-server</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 第三方版本：只在这里写一次，模块里不重复写版本号 -->
        <spring-ai.version>2.0.1</spring-ai.version>
        <mybatis-spring-boot.version>4.1.0</mybatis-spring-boot.version>
        <mysql-connector.version>9.7.0</mysql-connector.version>
        <!--
          Flyway 这里**故意不写版本号**，两个坐标（spring-boot-starter-flyway、
          flyway-mysql）都交给 Boot 4.1.1 的 BOM 管。
          现查该 BOM：<flyway.version>12.4.0</flyway.version>（G0-03 证据 00-现状核对.txt C1 段）。
          理由不是偷懒：flyway-core 与 flyway-mysql 版本一旦不一致会直接报错，
          版本只能有一个事实来源；而 Boot 自己已经不落后了。
        -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency><groupId>org.apache.pdfbox</groupId><artifactId>pdfbox</artifactId><version>3.0.8</version></dependency>
            <!-- Spring AI：只导入 BOM，不引任何 spring-ai 制品。
                 导入 BOM 本身就会让 Maven 去中央库解析 org.springframework.ai:spring-ai-bom:2.0.1，
                 因此「坐标可解析」在本次构建里就有痕迹；真正引依赖推迟到 G3。 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- G0-03/G1 起 server 会用到：迁移与业务 SQL 走 MyBatis，不引入 JPA -->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql-connector.version}</version>
            </dependency>

            <!-- 本仓库内部模块：模块之间引依赖不写版本号 -->
            <dependency>
                <groupId>com.autocare</groupId>
                <artifactId>auto-care-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.autocare</groupId>
                <artifactId>auto-care-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
