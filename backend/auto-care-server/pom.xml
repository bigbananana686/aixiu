<?xml version="1.0" encoding="UTF-8"?>
<!--
  auto-care-server：启动类、Web 层、业务模块、持久化、任务（设计 §5.1）。

  依赖方向：server 依赖 ai（用 AI 能力）与 common（用公共类型）；
  依赖图上没有任何一条边指回 server——这一条是靠 Maven 的模块边界强制的，
  不是靠人自觉：ai 模块的 POM 里根本没有 auto-care-server 这个坐标可写。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.autocare</groupId>
        <artifactId>auto-care</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>auto-care-server</artifactId>
    <name>auto-care-server</name>
    <description>启动、权限、业务模块、持久化、任务与 API</description>

    <dependencies>
        <!--
          common 是「错误码、身份值对象、通用结果」的落点（设计 §5.1）。
          它本来已经通过 ai → common 传递进来了，这里仍然显式写一条：
          本模块的错误信封、字段级子码、业务异常都直接 import common 的类型，
          用传递依赖等于「把自己的编译依赖挂在别人的依赖上」——
          哪天 ai 不再依赖 common，本模块会莫名其妙编不过，而且报错指向 import 行、不指向 pom。
          版本由父 POM 的 dependencyManagement 管，这里不写。
        -->
        <dependency>
            <groupId>com.autocare</groupId>
            <artifactId>auto-care-common</artifactId>
        </dependency>

        <dependency>
            <groupId>com.autocare</groupId>
            <artifactId>auto-care-ai</artifactId>
        </dependency>

        <!-- Boot 4 的 Web MVC 启动器：Servlet 栈 + 内嵌 Tomcat -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          ==================== G0-04 起启用身份与鉴权（Spring Security 全套） ====================
          依据：DISPATCH-009 DECIDE-1（用户 2026-10-22 拍板）。设计 §5.2 只写「API / JWT / 权限 / 校验」，
          没指定实现库，所以这是我们自己选的常规实现，换来标准做法与面试常见度。

          坐标名有坑，Boot 4 给安全相关 starter 改过名：
          `spring-boot-starter-oauth2-resource-server:4.1.1` 的 POM 描述原文是
            「Starter for using Spring Security's OAuth2 resource server features
              (deprecated in favor of spring-boot-starter-security-oauth2-resource-server)」
          所以这里用**新名**。旧名此刻仍能解析，但用旧名等于主动引一个已标弃用的坐标。
          `spring-boot-starter-security` 本身没改名。

          版本一律不写，交给 Boot 4.1.1 的 BOM：
          BOM 里 <spring-security.version>7.1.1</spring-security.version>（2026-10-22 现查）；
          实际落到的版本不靠这段注释，靠本节证据 13-依赖树-关键行.txt。
          名字里带 oauth2-resource-server 的那个 starter 会带进 spring-security-oauth2-jose（NimbusJwtDecoder 就在里面）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>

        <!--
          ============================ G0-03 起启用持久化 ============================
          本片（G0-03）才把数据源放上 classpath。G0-02 刻意不引的理由是「一旦进 classpath
          Boot 启动即建连」，与本片要做的迁移正好对上，所以到这里才加。

          Flyway：坐标是 starter + flyway-mysql 两块，缺一不可。
            - spring-boot-starter-flyway:4.1.1 → spring-boot-starter / -starter-jdbc /
              spring-boot-flyway / spring-boot-jdbc；flyway-core 由 spring-boot-flyway 传递进来。
            - org.flywaydb:flyway-mysql → 官方 MySQL 页原文「MySQL support is a separate
              dependency for Flyway and will need to be added to your Java project」，
              不加它连库时会找不到对应实现。
          两个坐标的版本都交给 Boot 4.1.1 的 BOM 管（现查 = Flyway 12.4.0）。
          **不在父 POM 里另钉一个 flyway 版本**：flyway-core 与 flyway-mysql 版本一旦
          不一致会直接报错，版本只能有一个事实来源。

          连接池：spring-boot-starter-jdbc 已带 HikariCP，隔离级别在 application-example.yml
          里统一配，不是只对某个会话 SET 一下。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- 持久化按设计走 MyBatis（不用 JPA），版本已在父 POM 锁定 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          测试作用域的安全测试支持：MockMvc 下造「已认证 / 指定角色」的请求靠它
          （@WithMockUser、以及 jwt() 请求后处理器）。第 6 节验角色闸门 403 要用，
          而本片没有生产角色受限端点——所以闸门只能用测试态路由验，不许往生产代码里塞假接口。
          test 作用域，不进 fat jar。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          WebMVC 的测试自动配置（@AutoConfigureMockMvc 等等）。
          **Boot 4 把每个模块的测试支持拆成了独立 starter**，跟 spring-boot-starter-security-test 一个套路：
          光是 spring-boot-starter-test + spring-boot-test-autoconfigure 已经**不再**包含
          org.springframework.boot.webmvc.test.autoconfigure 这个包了。
          症状很有欺骗性：testCompile 报「程序包 … 不存在」，但 spring-boot-test-autoconfigure
          明明在 classpath 上 —— 所以看到"包不存在"要先分清是"包名写错"还是"制品没引"。
          （2026-10-24 这一轮两种都踩了一遍：先错在包名，改对包名后又发现制品没引。）
          test 作用域，不进 fat jar。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 打出可 java -jar 运行的 fat jar（repackage 执行由 Boot 父 POM 的 pluginManagement 提供） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
