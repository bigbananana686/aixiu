page {
  background: #f7f6f6;
  color: #292326;
  font-size: 28rpx;
  line-height: 1.5;
}
.screen { padding: 28rpx 32rpx 56rpx; }
.demo { font-size: 23rpx; color: #685b5e; margin-bottom: 24rpx; }
.title { display: block; font-size: 44rpx; line-height: 1.2; font-weight: 700; }
.sub { display: block; margin-top: 12rpx; color: #685b5e; }
.section { margin-top: 24rpx; padding: 24rpx; background: #fff; border: 1rpx solid #e8dedf; border-radius: 10rpx; }
.section-title { display: block; margin-bottom: 12rpx; font-size: 30rpx; font-weight: 700; }
.row { display: flex; justify-content: space-between; align-items: baseline; gap: 20rpx; padding: 16rpx 0; border-top: 1rpx solid #e8dedf; }
.row-value { flex: 1; text-align: right; }
.label { flex: none; color: #685b5e; }
.pending { margin-top: 24rpx; padding: 22rpx 24rpx; color: #8c3237; background: #fff0f0; border-left: 6rpx solid #8c3237; }
.amount { display: block; margin: 4rpx 0; font-size: 56rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.action { margin: 22rpx 0 0; border-radius: 8rpx; background: #b9232b; color: #fff; font-size: 30rpx; line-height: 88rpx; }
.action::after { border: 0; }
.event { display: flex; gap: 24rpx; padding: 13rpx 0; border-top: 1rpx solid #e8dedf; }
.event-time { color: #685b5e; font-variant-numeric: tabular-nums; }
.footnote { display: block; margin-top: 14rpx; color: #685b5e; font-size: 24rpx; }

.mobile-hero { padding: 28rpx 26rpx; background: #6f1d26; color: #fff; border-radius: 12rpx; }
.ticket-kicker { display: block; margin-bottom: 14rpx; color: #f3cdd2; font-size: 23rpx; letter-spacing: 1rpx; }
.hero-sub { display: block; margin-top: 10rpx; color: #f8dfe1; }
.hero-status { display: inline-block; margin-top: 18rpx; padding: 3rpx 12rpx; border-radius: 4rpx; color: #6f1d26; background: #f9dfe2; font-size: 24rpx; }
.entry { display: block; text-align: center; }
.secondary { margin: 16rpx 0 0; padding: 0 16rpx; border: 1rpx solid #d7caca; border-radius: 8rpx; background: #fff; color: #b9232b; line-height: 78rpx; font-size: 27rpx; }
.secondary::after, .choice::after { border: 0; }
.order-link { display: block; padding: 20rpx 0; border-top: 1rpx solid #e8dedf; }
.order-title { display: flex; justify-content: space-between; align-items: center; gap: 10rpx; font-size: 31rpx; font-weight: 700; }
.badge { padding: 3rpx 10rpx; background: #f3eded; color: #b9232b; font-size: 23rpx; font-weight: 400; }
.choice { display: flex; width: 100%; min-height: 78rpx; align-items: center; justify-content: space-between; gap: 10rpx; margin: 12rpx 0 0; padding: 12rpx 16rpx; border: 1rpx solid #e8dedf; border-radius: 7rpx; background: #fff; color: #292326; font-size: 26rpx; text-align: left; line-height: 1.4; }
.chosen { border-color: #b9232b; background: #fbebed; color: #b9232b; font-weight: 700; }
.field-label { display: block; margin-top: 20rpx; margin-bottom: 8rpx; color: #685b5e; }
.field { min-height: 78rpx; padding: 0 14rpx; border: 1rpx solid #d7caca; border-radius: 7rpx; color: #292326; background: #fff; }
.error { margin-top: 15rpx; color: #9b2e22; }
.strong { font-weight: 700; }
.quote-history-row + .quote-history-row { margin-top: 20rpx; padding-top: 12rpx; border-top: 1rpx solid #e8dedf; }
.quote-deadline { display: block; margin-top: 12rpx; color: #b9232b; }
.reject-reason { width: 100%; height: 140rpx; padding: 16rpx; box-sizing: border-box; }
.quote-section { animation: show-quote .18s ease-out; }
@keyframes show-quote { from { opacity: .6; transform: translateY(5rpx); } to { opacity: 1; transform: translateY(0); } }
.event { position: relative; margin-left: 8rpx; padding: 13rpx 0 13rpx 20rpx; border-top: 0; border-left: 2rpx solid #e8dedf; }
.event::before { content: ""; position: absolute; left: -6rpx; top: 26rpx; width: 10rpx; height: 10rpx; border-radius: 50%; background: #d9b8ba; }
.event-current { color: #b9232b; font-weight: 700; }
.event-current::before { background: #b9232b; }
@media (prefers-reduced-motion: reduce) { .quote-section { animation: none; } }
