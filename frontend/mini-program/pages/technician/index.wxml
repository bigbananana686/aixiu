<view wx:if="{{order}}" class="screen">
  <view wx:if="{{demoMode}}" class="demo">技师端 · 示例数据</view>
  <view class="mobile-hero">
    <text class="ticket-kicker">{{order.orderNo || order.id}} · 上门工单</text>
    <text class="title">{{order.statusLabel}}</text>
    <text class="hero-sub">{{order.service}}</text>
  </view>
  <view class="next-task">
    <text class="section-title">当前任务</text>
    <text>{{guidance}}</text>
    <text wx:if="{{order.quote && order.quote.status === 'PENDING'}}" class="quote-deadline">报价于 {{order.quote.deadline}} 到期</text>
    <text wx:if="{{order.status === 'reserved' && order.acceptDeadlineText}}" class="footnote">接单截止 {{order.acceptDeadlineText}}</text>
    <button wx:if="{{action}}" class="action" disabled="{{busy}}" bindtap="act" data-action="{{action.key}}">{{action.label}}</button>
    <button wx:if="{{order.status === 'reserved'}}" class="secondary" disabled="{{busy}}" bindtap="act" data-action="decline">拒绝接单</button>
  </view>
  <text wx:if="{{error}}" class="error">{{error}}</text>
  <view wx:if="{{completeOpen && order.status === 'working'}}" class="section">
    <text class="section-title">记录完工</text>
    <text class="field-label">完工结果</text>
    <textarea class="field" maxlength="500" value="{{serviceResult}}" bindinput="editServiceResult" placeholder="填写本次服务结果"/>
    <text class="field-label">当前里程（选填）</text>
    <input class="field" type="number" maxlength="7" value="{{mileage}}" bindinput="editMileage"/>
    <button class="action" disabled="{{busy}}" bindtap="complete">提交完工</button>
  </view>
  <navigator wx:if="{{order.status === 'arrived' || order.status === 'working'}}" class="action entry" url="/pages/quote/index?id={{order.id}}">{{order.status === 'working' ? '发布增项报价' : '发布初始报价'}}</navigator>
  <block wx:if="{{order.quote && order.quote.status === 'PENDING'}}">
    <navigator class="secondary entry" url="/pages/quote/index?id={{order.id}}">替换待确认报价</navigator>
    <button class="secondary" disabled="{{busy}}" bindtap="withdraw">撤回当前报价</button>
  </block>
  <button wx:if="{{order.status === 'ready' || order.status === 'working'}}" class="secondary" bindtap="toggleExtension">{{showExtension ? '收起延期' : '申请运行延期'}}</button>
  <view wx:if="{{showExtension && (order.status === 'ready' || order.status === 'working')}}" class="section">
    <text class="section-title">仅延长服务时间</text>
    <text class="footnote">已承诺结束 {{order.committedEndLabel}}。本操作只调整结束时间。</text>
    <text class="field-label">再延长多少分钟</text><input class="field" type="number" value="{{extensionMinutes}}" bindinput="editMinutes" placeholder="如 30"/>
    <text class="field-label">延期原因</text><input class="field" value="{{extensionReason}}" maxlength="500" bindinput="editExtensionReason" placeholder="说明现场情况"/>
    <button class="action" disabled="{{busy}}" bindtap="extend">确认延期</button>
  </view>
  <navigator wx:if="{{demoMode}}" class="secondary entry" url="/pages/chat/index?id={{order.id}}">联系车主</navigator>
  <view class="section">
    <text class="section-title">现场信息</text>
    <view wx:for="{{order.bookingItems}}" wx:key="serviceId" class="row"><text class="label">预约项目</text><text class="row-value">{{item.name}} × {{item.quantity}}</text></view>
    <view class="row"><text class="label">车辆</text><text class="row-value">{{order.car}} {{order.plate}}</text></view>
    <view class="row"><text class="label">停车位置</text><text class="row-value">{{order.address}}</text></view>
    <view class="row"><text class="label">预约窗口</text><text class="row-value">{{order.appointment}}</text></view>
    <view class="row"><text class="label">承诺结束</text><text class="row-value">{{order.committedEndLabel}}</text></view>
  </view>
  <view wx:if="{{order.approvedQuote}}" class="section">
    <text class="section-title">当前已批准范围</text>
    <view class="row" wx:for="{{order.approvedQuote.items}}" wx:key="lineKey"><text>{{item.name}} × {{item.quantity}}</text><text>¥{{item.amount}}</text></view>
    <view class="row"><text>合计</text><text class="strong">¥{{order.approvedQuote.total}}</text></view>
  </view>
  <view wx:if="{{order.quotes.length}}" class="section">
    <text class="section-title">报价历史</text>
    <view wx:for="{{order.quotes}}" wx:key="id" class="quote-history-row">
      <view class="row"><text>第 {{item.version}} 版 · {{item.purposeLabel}}</text><text>{{item.statusLabel}}</text></view>
      <text class="strong">¥{{item.total}} · {{item.totalMinutes}} 分钟</text>
      <text class="footnote">{{item.reason}}</text>
    </view>
  </view>
  <view wx:if="{{!demoMode && (order.quote || order.approvedQuote)}}" class="section">
    <text class="section-title">报价分析</text>
    <button class="secondary" disabled="{{busy}}" bindtap="requestAnalysis">请求分析</button>
    <view wx:if="{{analysisJob}}"><text class="footnote">{{analysisStatus}}</text><text class="footnote">{{analysisText}}</text>
      <button class="secondary" disabled="{{busy}}" bindtap="refreshAnalysis">刷新分析结果</button>
    </view>
  </view>
  <view wx:if="{{order.exceptions.length}}" class="section">
    <text class="section-title">服务异常</text>
    <view wx:for="{{order.exceptions}}" wx:key="id"><text class="strong">{{item.label}}</text><text class="footnote">{{item.detail}}</text></view>
  </view>
</view>
<view wx:else class="screen">{{loading ? '正在读取工单…' : error || '该工单已不可查看，请返回任务列表。'}}
  <button wx:if="{{error && !loading}}" class="secondary" bindtap="refresh">重试</button>
</view>
