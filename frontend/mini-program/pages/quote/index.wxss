.quote-choice { display: flex; gap: 14rpx; align-items: center; padding: 17rpx 0; border-top: 1rpx solid #e8dedf; }
.quote-choice-info { flex: 1; min-width: 0; }
.quote-choice-info .footnote { margin-top: 3rpx; }
.quantity-controls { display: flex; align-items: center; gap: 10rpx; }
.quantity-controls button { display: flex; align-items: center; justify-content: center; width: 50rpx; height: 50rpx; margin: 0; padding: 0; border-radius: 7rpx; background: #fff0ef; color: #a61923; line-height: 1; }
.quantity-controls button::after { border: 0; }
.quote-reason { box-sizing: border-box; width: 100%; height: 150rpx; padding: 14rpx; border: 1rpx solid #d7caca; border-radius: 8rpx; }
